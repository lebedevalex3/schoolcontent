# ==================================================
# Сгенерированные файлы LaTeX
# Исходные .tex-файлы НЕ игнорируются
# ==================================================

# Основной результат компиляции
*.pdf
*.pptx

# Видео и другие готовые медиа хранятся на Яндекс.Диске, а не в Git
*.ppt
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
*.mp3
*.wav

# Локальная авторизация для публикации на Яндекс.Диск
.secrets/

# Каталоги сборки в любой части репозитория
tmp/
**/tmp/
temp/
**/temp/
outputs/
**/outputs/
build/
**/build/
# Вспомогательные файлы LaTeX
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex
*.synctex.gz
*.xdv
*.dvi
*.ps

# Библиография
*.bbl
*.bcf
*.blg
*.run.xml

# Индексы и глоссарии
*.idx
*.ilg
*.ind
*.ist
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.glsdefs

# Beamer
*.nav
*.snm
*.vrb

# Временные файлы
*.tmp
*.bak
*.backup
*.sav
*.swp
*.lock
*~

# ==================================================
# Архивы и служебный мусор
# ==================================================

# Архивы исходных паков (тяжёлые, собираются из .tex)
*.zip
*.tar
*.tar.gz
*.7z

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
